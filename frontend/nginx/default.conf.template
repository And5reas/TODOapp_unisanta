# Configuração do Nginx para o Frontend Angular.
# Processada pelo entrypoint da imagem oficial (envsubst) que substitui
# apenas as variáveis de ambiente definidas (ex.: ${BACKEND_UPSTREAM}).
server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Endpoint usado pelo healthcheck do container
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # Chamadas /api/* do Frontend são encaminhadas ao Backend
    # através da rede interna do Docker (sem localhost no navegador).
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # Roteamento SPA: rotas internas caem no index.html (fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Arquivos com hash (gerados pelo Angular) podem ser cacheados
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
}
