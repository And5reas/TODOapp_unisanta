{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "npm",
      "script": "start",
      "path": "backend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "javascript",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "Database Connected"
          }
        }
      }
    },
    {
      "label": "Start Frontend",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "."
          },
          "endsPattern": {
            "regexp": "Application bundle generation complete\\."
          }
        }
      }
    },
    {
      "label": "Run Tests",
      "type": "npm",
      "script": "test",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Backend",
        "Start Frontend"
      ],
      "problemMatcher": []
    },
    {
      "label": "Kill Backend",
      "type": "shell",
      "command": "npx kill-port 3000",
      "problemMatcher": []
    },
    {
      "label": "Kill Frontend",
      "type": "shell",
      "command": "npx kill-port 4200",
      "problemMatcher": []
    }
  ]
}